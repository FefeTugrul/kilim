+    gobek: agirlikDizisi(GOBEK_ADAYLARI_V2, profil.gobekAgirlik),
+    bordur: agirlikDizisi(BORDUR_ADAYLARI_V2, profil.bordurAgirlik),
+    dolgu: agirlikDizisi(DOLGU_ADAYLARI_V2, profil.dolguAgirlik),
