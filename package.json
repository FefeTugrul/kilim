{
  "name": "kilim",
  "version": "0.0.0",
  "description": "Deterministic Anatolian kilim avatars from any string. Zero dependencies, pure SVG.",
  "keywords": [
    "avatar",
    "identicon",
    "generative",
    "svg",
    "kilim",
    "pattern",
    "deterministic",
    "placeholder"
  ],
  "license": "MIT",
  "author": "Furkan Efe Tuğrul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FefeTugrul/kilim.git"
  },
  "homepage": "https://github.com/FefeTugrul/kilim#readme",
  "bugs": "https://github.com/FefeTugrul/kilim/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "onizleme": "npm run build && node scripts/onizleme.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
